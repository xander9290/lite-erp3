model Partner {
    id                 String                @id @default(cuid())
    name               String
    email              String?
    imageUrl           String?               @default("/images/avatar_default.svg")
    phone              String?
    street             String?
    houseNumber        String?               @map("house_number")
    streets            String?
    town               String?
    zip                Int?
    county             String?
    province           String?
    country            String?
    completeAddress    String?               @map("complete_address")
    vat                String?
    displayType        PartnerDisplayType    @default(INTERNAL) @map("display_type")
    active             Boolean               @default(true)
    createdUid         String                @map("created_uid")
    createdAt          DateTime              @default(now()) @map("created_at")
    updatedAt          DateTime              @updatedAt @map("updated_at")
    userId             String?               @map("user_id")
    mobile             String?
    Company            Company?              @relation("PartnerCompanyRel")
    UserManager        User?                 @relation("PartnerManagerRel", fields: [userId], references: [id], onDelete: Cascade)
    Products           ProductTemplate[]     @relation("ProductSupplierRel")
    PurchaseOrders     PurchaseOrder[]
    User               User?                 @relation("PartnerUserRelated")
    Tags               Tag[]                 @relation("PartnerTagsRelation")
    SaleOrderShippings SaleOrder[]           @relation("PartnerShipping")
    saleOrders         SaleOrder[]
    obs                String?
    paymentTermId      String?               @map("payment_term_id")
    PaymentTerm        InvoicingPaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
    productPricelist   ProductPricelistItem? @map("product_pricelist")

    parentId String?   @map("parent_id")
    Parent   Partner?  @relation("PartnerParent", fields: [parentId], references: [id], onDelete: Cascade)
    Children Partner[] @relation("PartnerParent")

    PickingOperators StockPicking[] @relation("PickingOperator")
    PickingPartners  StockPicking[] @relation("PickingPartner")

    AccountInvoices InvoicingInvoice[]

    @@index([name])
    @@map("partners")
}

enum PartnerDisplayType {
    INTERNAL
    CUSTOMER
    SUPPLIER
    CONTACT
    DELIVERY
}
