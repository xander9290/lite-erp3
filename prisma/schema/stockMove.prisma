model StockMove {
    id              String                  @id @default(cuid())
    name            String
    reference       String
    quantity        Float                   @default(0.0)
    date            DateTime                @default(now()) @db.Date
    productId       String                  @map("product_id")
    warehouseId     String                  @map("warehouse_id")
    warehouseDestId String                  @map("warehouse_dest_id")
    userId          String                  @map("user_id")
    createdAt       DateTime                @default(now()) @map("created_at")
    updatedAt       DateTime                @updatedAt @map("updated_at")
    moveType        StockMoveType           @map("move_type")
    companyId       String                  @map("company_id")
    Company         Company                 @relation(fields: [companyId], references: [id])
    Product         ProductTemplate         @relation(fields: [productId], references: [id])
    User            User                    @relation(fields: [userId], references: [id])
    WarehouseDest   Warehouse               @relation("DestWarehouseMove", fields: [warehouseDestId], references: [id])
    WarehouseOrigin Warehouse               @relation("OriginWarehouseMove", fields: [warehouseId], references: [id])
    docLink         String?                 @map("doc_link")
    JournalEntries  InvoicingJournalEntry[]

    @@map("stock_move")
}

enum StockMoveType {
    outgoing
    incoming
}
